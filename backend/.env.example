# Z-TRACS AWS Production Backend Environment Template
# Copy this file to .env and fill in your actual credentials.

POSTGRES_HOST=your-rds-endpoint.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_secure_db_password

DATABASE_URL=postgresql://your_db_username:your_secure_db_password@your-rds-endpoint.rds.amazonaws.com:5432/postgres
ENV=production
PORT=5000
HOST=0.0.0.0
JWT_SECRET=your_64_character_hex_jwt_secret
